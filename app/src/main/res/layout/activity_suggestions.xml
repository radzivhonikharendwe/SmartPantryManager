<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/pantry_background">

    <!-- Header card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:background="@drawable/card_background">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR NEXT MEAL"
                android:textColor="@color/pantry_green"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recipe suggestions"
                android:textColor="@color/pantry_text"
                android:textSize="23sp"
                android:textStyle="bold"
                android:paddingTop="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Make something delicious today!"
                android:textColor="@color/pantry_muted"
                android:textSize="13sp"
                android:paddingTop="4dp" />
        </LinearLayout>

        <ImageView
            android:layout_width="85dp"
            android:layout_height="75dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="Smart Pantry food illustration" />
    </LinearLayout>

    <!-- Explanation -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Discover recipes you can make with the ingredients and quantities available in your pantry."
        android:textColor="@color/pantry_muted"
        android:textSize="14sp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp" />

    <!-- Suggestions status -->
    <TextView
        android:id="@+id/txtSuggestionMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Finding recipes for you..."
        android:textColor="@color/pantry_green_dark"
        android:textStyle="bold"
        android:textSize="14sp"
        android:padding="12dp"
        android:background="@color/pantry_mint" />

    <!-- Matching recipes -->
    <ListView
        android:id="@+id/listSuggestions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_background"
        android:divider="@color/pantry_border"
        android:dividerHeight="1dp"
        android:padding="6dp"
        android:clipToPadding="false" />

    <!-- Browse all recipes -->
    <Button
        android:id="@+id/btnAllRecipes"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="Browse All Recipes"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/pantry_green"
        android:elevation="3dp" />

    <!-- Bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnNavPantry"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Pantry"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:backgroundTint="@color/pantry_mint"
            android:textColor="@color/pantry_green_dark" />

        <Button
            android:id="@+id/btnNavRecipes"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="Recipes"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:backgroundTint="@color/pantry_green"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Settings"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:backgroundTint="@color/pantry_mint"
            android:textColor="@color/pantry_green_dark" />

    </LinearLayout>

</LinearLayout>
