<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <ImageView
            android:layout_width="86dp"
            android:layout_height="94dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="Smart Pantry food illustration"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Your Recipe"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/pantry_green"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save your favourite meals and the ingredients needed to prepare them."
            android:textSize="14sp"
            android:textColor="@color/pantry_muted"
            android:gravity="center"
            android:paddingBottom="20dp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="202dp"
            android:background="@drawable/card_background"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="RECIPE DETAILS"
                android:textColor="@color/pantry_green_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRecipeName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/pantry_green"
                android:hint="Recipe name"
                android:inputType="textCapSentences"
                android:paddingHorizontal="12dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etRecipeMethod"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:backgroundTint="@color/pantry_green"
                android:gravity="top|start"
                android:hint="Cooking instructions"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="12dp" />

        </LinearLayout>

        <!-- Ingredients section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/pantry_green_dark"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add each ingredient with its required quantity and unit."
            android:textSize="14sp"
            android:textColor="@color/pantry_muted"
            android:paddingBottom="12dp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:elevation="2dp">

            <EditText
                android:id="@+id/etIngredientName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:paddingHorizontal="12dp"
                android:hint="Ingredient name (e.g. tomato)"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:backgroundTint="@color/pantry_green" />

            <EditText
                android:id="@+id/etIngredientQuantity"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:paddingHorizontal="12dp"
                android:hint="Quantity (e.g. 2)"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:backgroundTint="@color/pantry_green" />

            <EditText
                android:id="@+id/etIngredientUnit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingHorizontal="12dp"
                android:hint="Unit (e.g. g, ml, piece)"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:backgroundTint="@color/pantry_green" />

            <Button
                android:id="@+id/btnAddIngredient"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="+ Add Ingredient"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/pantry_green_dark"
                android:backgroundTint="@color/pantry_mint" />

        </LinearLayout>


        <TextView
            android:id="@+id/tvIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="14dp"
            android:background="@drawable/card_background"
            android:text="Added ingredients will appear here"
            android:textColor="@color/pantry_text"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />


        <Button
            android:id="@+id/btnSaveRecipe"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:text="Save Recipe"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/pantry_green"
            android:elevation="3dp" />

    </LinearLayout>

</ScrollView>

