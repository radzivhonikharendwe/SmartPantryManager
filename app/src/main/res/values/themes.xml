<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/pantry_green</item>
        <item name="android:statusBarColor">@color/pantry_green_dark</item>
        <item name="android:navigationBarColor">@color/pantry_green_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/pantry_background</item>
        <item name="android:buttonStyle">@style/PantryButton</item>
    </style>
    <style name="PantryButton" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/pantry_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>